# Optional AI runners. Both CLIs must already be authenticated.
RISE_SOCIAL_CODEX_BIN=codex
RISE_SOCIAL_CLAUDE_BIN=claude

# Optional YouTrack task synchronization. Without it, prepare remains local and
# stores boardSync=pending. Prefer macOS Keychain or a process environment.
RISE_SOCIAL_YOUTRACK_BASE_URL=https://rise.youtrack.cloud
RISE_SOCIAL_YOUTRACK_PROJECT=RISE
RISE_SOCIAL_YOUTRACK_BOARD_ID=204-1
RISE_SOCIAL_YOUTRACK_TOKEN=

# Optional automatic publishing. Manual export works without these.
BUFFER_API_KEY=
BUFFER_API_URL=https://api.buffer.com
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_FACEBOOK_CHANNEL_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
